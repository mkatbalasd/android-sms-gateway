<?xml version="1.0" encoding="utf-8"?>
<!--
    CARD-25 send-only build (build types sendOnly and sendOnlyE2e). Merged over the main manifest:
    the four permissions Google Play Protect names for a browser-install block, and the receivers
    that need them, are removed. SEND_SMS stays, so number proof (MO) and delivery reports work.
    e2e/send-only-guard.sh fails the build if any of them is still in the merged manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.RECEIVE_SMS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_SMS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_MMS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_WAP_PUSH"
        tools:node="remove" />

    <application>
        <receiver
            android:name="me.capcom.smsgateway.modules.receiver.MessagesReceiver"
            tools:node="remove" />
        <receiver
            android:name="me.capcom.smsgateway.modules.receiver.MmsReceiver"
            tools:node="remove" />
    </application>

</manifest>
